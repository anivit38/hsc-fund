# Copy this file to .env for local development (both the Vite frontend and the
# Express backend read one .env at the project root when run locally).

# --- Frontend (Vite) ---
# Where the React app should send API requests. Point this at your Render URL
# once deployed (e.g. https://hsc-fund-api.onrender.com); defaults to
# http://localhost:8080 for local dev if unset.
VITE_API_URL=http://localhost:8080

# --- Backend (Express, src/server/index.js) ---
# Secret used to sign login JWTs. MUST be set to a long random value in
# production (Render → your service → Environment). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret-change-me

# Comma-separated list of origins allowed to call the API (your Firebase
# Hosting URL(s)). Leave unset locally to allow any origin.
# CORS_ORIGIN=https://your-project.web.app,https://your-project.firebaseapp.com

# Pull real prices from Yahoo Finance (no API key needed). Set to "false" to
# run entirely on the deterministic simulator (useful offline/in CI).
LIVE_MARKET=true

# Where the JSON "database" file lives. Defaults to ./data/db.json.
# DB_FILE=./data/db.json

PORT=8080
NODE_ENV=development
